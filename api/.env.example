NODE_ENV=development
PORT=3000

# PostgreSQL connection string (Neon: copy it from the dashboard, keep ?sslmode=require)
DATABASE_URL=

# Long random string (at least 32 characters), e.g. `openssl rand -base64 48`
JWT_SECRET=

# Allowed origins, comma separated ("*" is fine for a mobile app)
CORS_ORIGIN=*

# Login attempts allowed per IP per minute
LOGIN_RATE_LIMIT=10

# Used by `npm run seed` to create the first admin account
ADMIN_IDENTIFIER=
ADMIN_PASSWORD=

# Optional seed settings
# SEED_DEMO=true         demo users, rooms, equipment (default: true in development, false in production)
# DEMO_PASSWORD=         password of the demo users (defaults to 1234 in development only)

# Tests only: a throwaway LOCAL database, because the tests empty its tables
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/craie_test
