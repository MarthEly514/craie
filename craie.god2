/><circle cx=\"17\" cy=\"9\" r=\"2.5\"/><path d=\"M17 14.5a5.5 5.5 0 014.5 5.5\"/></symbol>\n  <symbol id=\"i-bouclier\" viewBox=\"0 0 24 24\"><path d=\"M12 3l8 3v6c0 4.5-3.2 8-8 9-4.8-1-8-4.5-8-9V6z\"/></symbol>\n  <symbol id=\"i-liste\" viewBox=\"0 0 24 24\"><path d=\"M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01\"/></symbol>\n  <symbol id=\"i-corbeille\" viewBox=\"0 0 24 24\"><path d=\"M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13\"/></symbol>\n  <symbol id=\"i-pause\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M10 9v6M14 9v6\"/></symbol>\n  <symbol id=\"i-cadenas\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"11\" width=\"14\" height=\"10\" rx=\"2.5\"/><path d=\"M8 11V8a4 4 0 018 0v3\"/></symbol>\n  <symbol id=\"i-mail\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"3.5\"/><path d=\"M3.5 7.5l8.5 6 8.5-6\"/></symbol>\n  <symbol id=\"i-sortie\" viewBox=\"0 0 24 24\"><path d=\"M10 4H6a2 2 0 00-2 2v12a2 2 0 002 2h4M15 8l4 4-4 4M19 12H9\"/></symbol>\n  <symbol id=\"i-attention\" viewBox=\"0 0 24 24\"><path d=\"M12 4l9.5 16h-19zM12 10v4M12 17.2v.01\"/></symbol>\n  <symbol id=\"i-crayon\" viewBox=\"0 0 24 24\"><path d=\"M4 20l1-4L16 5a2.1 2.1 0 013 3L8 19z\"/></symbol>\n  <symbol id=\"i-cloche\" viewBox=\"0 0 24 24\"><path d=\"M6 16v-5a6 6 0 0112 0v5l1.5 2h-15zM10 21h4\"/></symbol>\n  <symbol id=\"i-sparkle\" viewBox=\"0 0 24 24\"><path d=\"M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5L18 18M18 6l-2.5 2.5M8.5 15.5L6 18\"/></symbol>\n  <symbol id=\"i-oeil\" viewBox=\"0 0 24 24\"><path d=\"M3 11c3 4.5 15 4.5 18 0M6.5 15.2L5 17.5M10.5 16.5l-.6 2.5M14.5 16.5l.6 2.5M17.5 15.2l1.5 2.3\"/></symbol>\n  <!-- Les dessins d’accueil : trait noir, un aplat, trois ellipses au sol -->\n  <symbol id=\"img-salles\" viewBox=\"0 0 240 200\">\n    <rect x=\"76\" y=\"34\" width=\"88\" height=\"142\" rx=\"12\" fill=\"#fff\"/>\n    <rect x=\"90\" y=\"50\" width=\"60\" height=\"62\" rx=\"8\"/>\n    <rect x=\"90\" y=\"124\" width=\"60\" height=\"38\" rx=\"8\"/>\n    <circle cx=\"150\" cy=\"140\" r=\"5\" fill=\"#000\" stroke=\"none\"/>\n    <rect x=\"100\" y=\"8\" width=\"40\" height=\"18\" rx=\"7\" fill=\"#000\" stroke=\"none\"/>\n    <circle cx=\"120\" cy=\"17\" r=\"3.2\" fill=\"#fff\" stroke=\"none\"/>\n    <path d=\"M178 62l16-10M182 80l20-2M176 44l10-14\"/>\n    <path d=\"M60 176h-24M204 176h-8\" />\n    <ellipse cx=\"44\" cy=\"190\" rx=\"14\" ry=\"4\"/><ellipse cx=\"196\" cy=\"192\" rx=\"8\" ry=\"3\"/>\n    <ellipse cx=\"120\" cy=\"194\" rx=\"6\" ry=\"2.6\" fill=\"#000\" stroke=\"none\"/>\n  </symbol>\n  <symbol id=\"img-materiel\" viewBox=\"0 0 240 200\">\n    <rect x=\"34\" y=\"92\" width=\"124\" height=\"62\" rx=\"16\" fill=\"#000\" stroke=\"none\"/>\n    <circle cx=\"124\" cy=\"123\" r=\"19\" fill=\"#fff\" stroke=\"none\"/>\n    <circle cx=\"124\" cy=\"123\" r=\"7\" fill=\"#000\" stroke=\"none\"/>\n    <path d=\"M62 154v14M130 154v14M52 168h20M120 168h20\"/>\n    <path d=\"M162 110l46-26M162 138l46 26\"/>\n    <rect x=\"204\" y=\"70\" width=\"14\" height=\"108\" rx=\"7\" fill=\"#fff\"/>\n    <path d=\"M40 92c0-14 8-20 22-20h30\"/>\n    <path d=\"M70 186c14 12 28 12 42 0s28-12 42 0\"/>\n    <ellipse cx=\"30\" cy=\"190\" rx=\"12\" ry=\"4\"/><ellipse cx=\"206\" cy=\"194\" rx=\"7\" ry=\"3\"/>\n    <ellipse cx=\"120\" cy=\"196\" rx=\"5\" ry=\"2.4\" fill=\"#000\" stroke=\"none\"/>\n  </symbol>\n  <symbol id=\"img-creneaux\" viewBox=\"0 0 240 200\">\n    <rect x=\"44\" y=\"40\" width=\"152\" height=\"124\" rx=\"18\" fill=\"#fff\"/>\n    <path d=\"M44 74h152M88 28v22M152 28v22\"/>\n    <rect x=\"68\" y=\"92\" width=\"34\" height=\"26\" rx=\"8\" fill=\"#000\" stroke=\"none\"/>\n    <circle cx=\"85\" cy=\"105\" r=\"3.4\" fill=\"#fff\" stroke=\"none\"/>\n    <rect x=\"118\" y=\"92\" width=\"34\" height=\"26\" rx=\"8\"/>\n    <rect x=\"68\" y=\"128\" width=\"34\" height=\"22\" rx=\"8\"/>\n    <circle cx=\"170\" cy=\"140\" r=\"22\" fill=\"#fff\"/>\n    <path d=\"M160 140l7 7 13-14\"/>\n    <path d=\"M206 46l12-10M210 62l16-2\"/>\n    <ellipse cx=\"60\" cy=\"184\" rx=\"13\" ry=\"4\"/><ellipse cx=\"190\" cy=\"188\" rx=\"8\" ry=\"3\"/>\n    <ellipse cx=\"120\" cy=\"190\" rx=\"6\" ry=\"2.6\" fill=\"#000\" stroke=\"none\"/>\n  </symbol>\n  <!-- La barre d’état -->\n  <symbol id=\"i-signal\" viewBox=\"0 0 24 24\"><path class=\"plein\" d=\"M3 17h3v4H3zM8.5 13h3v8h-3zM14 9h3v12h-3zM19.5 4h3v17h-3z\" fill=\"currentColor\" stroke=\"none\"/></symbol>\n  <symbol id=\"i-wifi\" viewBox=\"0 0 24 24\"><path d=\"M2.5 9a14 14 0 0119 0M5.5 12.5a9.5 9.5 0 0113 0M8.8 16a5 5 0 016.4 0M12 19.5v.01\"/></symbol>\n  <symbol id=\"i-batterie\" viewBox=\"0 0 24 24\"><rect x=\"2\" y=\"7\" width=\"18\" height=\"10\" rx=\"3\"/><path d=\"M22.5 11v2\"/><rect x=\"4.5\" y=\"9.5\" width=\"11\" height=\"5\" rx=\"1.2\" fill=\"currentColor\" stroke=\"none\"/></symbol>\n  <!-- Le trait de craie sous le logo -->\n  <symbol id=\"trait\" viewBox=\"0 0 200 18\"><path d=\"M3 11C40 4 80 15 120 8s60-4 77 2\"/></symbol>\n</svg>\n",
 "styles": "@font-face { font-family: 'WuraMi'; font-weight: 400; font-style: normal; font-display: block; src: url(data:font/woff2;base64,) format('woff2'); }\n@font-face { font-family: 'WuraMi'; font-weight: 600; font-style: normal; font-display: block; src: url(data:font/woff2;base64,) format('woff2'); }\n@font-face { font-family: 'WuraMi'; font-weight: 700; font-style: normal; font-display: block; src: url(data:font/woff2;base64,) format('woff2'); }\n/* ---- Craie : jetons ----\n   Palette relevée sur refs/UI_base.jpg : un vert forêt presque noir pour\n   l’encre et l’action principale, un citron vert vif pour l’accent, un gris\n   verdâtre très clair pour les surfaces, sur des écrans blancs. */\n:root {\n  --toile: #e3e2de;\n  --fond: #ffffff;\n  --surface: #f0f3ec;\n  --surface-2: #e4eadc;\n  --bord: #ececea;\n\n  --encre: #173300;\n  --encre-2: #2c4a12;\n  --texte: #182011;\n  --discret: #66735d;\n  --pale: #a3aa9c;\n\n  /* Un role par couleur. L’encre : ce qui se touche. Le citron : l’accent\n     et ce qui est libre. Le corail : pris, refusé, à ne pas rater. */\n  --lime: #9fe970;\n  --lime-clair: #e6f8d8;\n  --lime-fonce: #4f8a1f;\n  --corail: #c4432b;\n  --corail-clair: #fde9e4;\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\nhtml, body { height: 100%; }\nbody {\n  font-family: 'WuraMi', system-ui, sans-serif;\n  font-size: 15px;\n  line-height: 1.4;\n  color: var(--texte);\n  background: var(--fond);\n  -webkit-font-smoothing: antialiased;\n  word-spacing: 0.08em;\n}\n\n.ic { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; flex: none; }\n.ic.petit { width: 18px; height: 18px; }\n\n/* ---- Gabarit d’un écran ---- */\n.app { position: relative; height: 100vh; display: flex; flex-direction: column; overflow: hidden; background: var(--fond); }\n.barre-etat { position: relative; height: 54px; padding: 8px 30px 0; display: flex; align-items: center; justify-content: space-between; font-weight: 600; font-size: 15px; flex: none; color: var(--encre); }\n.ile { position: absolute; left: 50%; top: 11px; width: 104px; height: 30px; margin-left: -52px; border-radius: 15px; background: #000; }\n.etat-icones { display: flex; gap: 5px; align-items: center; }\n.etat-icones .ic { width: 18px; height: 18px; }\n.indicateur { position: absolute; left: 50%; bottom: 8px; width: 138px; height: 5px; margin-left: -69px; border-radius: 3px; background: var(--encre); }\n\n.entete { display: flex; align-items: center; gap: 12px; padding: 14px 20px 14px; flex: none; }\n.titre-ecran { flex: 1; font-size: 28px; font-weight: 700; letter-spacing: 0; line-height: 1.1; color: var(--encre); }\n.entete.compact .titre-ecran { font-size: 20px; letter-spacing: 0; text-align: center; }\n.entete.compact .bouton-rond:first-child:not(:last-child) { margin-right: 0; }\n.entete.compact::after { content: ''; width: 42px; flex: none; }\n.entete.compact:has(.bouton-rond:last-child:not(:first-child))::after { display: none; }\n.bouton-rond { width: 42px; height: 42px; border-radius: 50%; background: var(--surface); display: grid; place-items: center; position: relative; flex: none; color: var(--encre); }\n.bouton-rond .point { position: absolute; top: 10px; right: 11px; width: 9px; height: 9px; border-radius: 50%; background: var(--corail); border: 2px solid var(--surface); }\n\n.corps { flex: 1; overflow: hidden; padding: 2px 20px 20px; display: flex; flex-direction: column; gap: 14px; }\n.corps.centre { align-items: center; justify-content: center; text-align: center; gap: 12px; padding-bottom: 60px; }\n.pousse { flex: 1; }\n.rangee { display: flex; gap: 10px; }\n.rangee > * { flex: 1; }\n\n/* ---- Onglets ---- */\n.onglets { flex: none; display: flex; padding: 10px 12px 30px; background: var(--fond); border-top: 1px solid var(--bord); }\n.onglet { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px; font-size: 12px; font-weight: 600; color: var(--pale); }\n.onglet .pastille { width: 58px; height: 32px; border-radius: 16px; display: grid; place-items: center; }\n.onglet.actif { color: var(--encre); }\n.onglet.actif .pastille { background: var(--lime); }\n\n/* ---- Contrôles ---- */\n.segments { display: flex; background: var(--surface); border-radius: 99px; padding: 4px; flex: none; }\n.segment { flex: 1; text-align: center; padding: 10px 4px; border-radius: 99px; font-weight: 600; font-size: 14px; color: var(--discret); white-space: nowrap; }\n.segment.actif { background: var(--encre); color: #fff; }\n\n.puces { display: flex; gap: 8px; flex: none; flex-wrap: wrap; }\n.puce { padding: 9px 16px; border-radius: 99px; background: var(--surface); font-weight: 600; font-size: 14px; white-space: nowrap; display: flex; align-items: center; gap: 6px; color: var(--encre); }\n.puce.actif { background: var(--encre); color: #fff; }\n.puce.pris { color: var(--pale); background: transparent; text-decoration: line-through; box-shadow: inset 0 0 0 1.5px var(--bord); }\n.puce.discret { font-size: 13px; padding: 7px 13px; }\n\n.jours { display: flex; gap: 8px; flex: none; }\n.jour { flex: 1; text-align: center; padding: 10px 0; border-radius: 22px; background: var(--surface); display: flex; flex-direction: column; gap: 2px; font-size: 12px; font-weight: 600; color: var(--discret); }\n.jour b { font-size: 18px; color: var(--encre); }\n.jour.actif { background: var(--encre); color: hsl(0 0% 100% / 0.65); }\n.jour.actif b { color: #fff; }\n\n.btn { height: 50px; border-radius: 99px; background: var(--encre); color: #fff; font-weight: 600; font-size: 16px; display: flex; align-items: center; justify-content: center; gap: 10px; flex: none; }\n.btn.lime { background: var(--lime); color: var(--encre); }\n.btn.clair { background: var(--surface); color: var(--encre); }\n.btn.danger { background: var(--corail); }\n.btn.contour-danger { background: transparent; color: var(--corail); box-shadow: inset 0 0 0 1.5px var(--corail-clair); }\n.btn-petit { height: 38px; padding: 0 18px; border-radius: 99px; background: var(--encre); color: #fff; font-weight: 600; font-size: 14px; display: flex; align-items: center; justify-content: center; gap: 6px; }\n.btn-petit.clair { background: var(--surface); color: var(--encre); }\n.lien { text-align: center; font-weight: 500; color: var(--encre); text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; font-size: 14px; }\n.pied-lien { text-align: center; font-size: 14px; color: var(--discret); }\n.pied-lien b { color: var(--encre); font-weight: 700; }\n.ou { display: flex; align-items: center; gap: 14px; color: var(--discret); font-size: 13px; flex: none; }\n.ou::before, .ou::after { content: ''; flex: 1; height: 1px; background: var(--bord); }\n\n.champ { display: flex; flex-direction: column; gap: 7px; flex: none; }\n.champ label { font-size: 13px; font-weight: 600; color: var(--discret); padding-left: 18px; }\n.saisie { height: 50px; border-radius: 99px; background: var(--fond); box-shadow: inset 0 0 0 1.5px var(--bord); padding: 0 18px; display: flex; align-items: center; gap: 10px; font-size: 15px; color: var(--encre); }\n.saisie .ic { color: var(--pale); width: 22px; height: 22px; }\n.saisie .fin { margin-left: auto; color: var(--discret); font-size: 14px; font-weight: 600; display: flex; }\n.saisie.vide { color: var(--pale); }\n.saisie.focus { box-shadow: inset 0 0 0 1.5px var(--encre); }\n.recherche { height: 48px; border-radius: 99px; background: var(--surface); display: flex; align-items: center; gap: 10px; padding: 0 18px; color: var(--discret); flex: none; }\n\n.case { width: 24px; height: 24px; border-radius: 8px; box-shadow: inset 0 0 0 2px var(--surface-2); display: grid; place-items: center; flex: none; background: var(--fond); }\n.case.coche { background: var(--encre); box-shadow: none; color: var(--lime); }\n.case .ic { width: 16px; height: 16px; stroke-width: 2.6; }\n.case.ronde { border-radius: 50%; }\n\n/* ---- Cartes et lignes ---- */\n.carte { background: var(--surface); border-radius: 28px; padding: 18px; display: flex; flex-direction: column; gap: 12px; flex: none; }\n.carte.encre { background: var(--encre); color: #fff; }\n.carte.encre .sous { color: hsl(0 0% 100% / 0.65); }\n.liste { display: flex; flex-direction: column; gap: 10px; }\n.ligne { display: flex; align-items: center; gap: 14px; background: var(--surface); border-radius: 26px; padding: 12px 16px 12px 12px; flex: none; }\n.ligne.choisie { background: var(--lime-clair); box-shadow: inset 0 0 0 1.5px var(--lime); }\n.ligne.eteinte { opacity: 0.55; }\n.ligne .texte { flex: 1; min-width: 0; display: flex; flex-direction: column; }\n.titre { font-weight: 700; font-size: 16px; color: var(--encre); }\n.sous { font-size: 13px; color: var(--discret); }\n.vignette { width: 48px; height: 48px; border-radius: 50%; background: var(--fond); color: var(--encre); display: grid; place-items: center; flex: none; }\n.vignette.lime { background: var(--lime); color: var(--encre); }\n.vignette.corail { background: var(--corail-clair); color: var(--corail); }\n.vignette.encre { background: var(--encre); color: var(--lime); }\n.vignette.grand { width: 60px; height: 60px; }\n\n.statut { font-size: 12px; font-weight: 700; padding: 5px 12px; border-radius: 99px; white-space: nowrap; flex: none; }\n.statut.libre { background: var(--lime); color: var(--encre); }\n.statut.pris { background: var(--corail-clair); color: var(--corail); }\n.statut.attribue { background: var(--fond); color: var(--encre); }\n.statut.neutre { background: var(--surface-2); color: var(--encre); }\n\n.avatar { width: 46px; height: 46px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; font-size: 16px; background: var(--fond); color: var(--encre); flex: none; }\n.avatar.lime { background: var(--lime); }\n.avatar.encre { background: var(--encre); color: var(--lime); }\n.avatar.geant { width: 84px; height: 84px; font-size: 30px; }\n\n.tuiles { display: flex; gap: 12px; flex: none; }\n.tuile { flex: 1; background: var(--surface); border-radius: 28px; padding: 16px 18px; display: flex; flex-direction: column; }\n.tuile b { font-size: 32px; line-height: 1.1; letter-spacing: 0; color: var(--encre); }\n.tuile.lime { background: var(--lime); }\n.tuile.lime .sous { color: var(--encre-2); }\n\n.infos { display: flex; flex-direction: column; }\n.info { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--surface-2); gap: 12px; }\n.info:last-child { border-bottom: none; }\n.info span:first-child { color: var(--discret); }\n.info span:last-child { font-weight: 600; text-align: right; color: var(--encre); }\n\n.note { display: flex; gap: 12px; align-items: flex-start; background: var(--lime-clair); border-radius: 22px; padding: 14px 16px; font-size: 14px; color: var(--encre); flex: none; }\n.note .ic { margin-top: 1px; }\n.titre-section { font-size: 13px; font-weight: 700; color: var(--discret); text-transform: uppercase; letter-spacing: 0.06em; padding-left: 4px; flex: none; }\n\n/* ---- Emploi du temps ---- */\n.horaire { display: flex; gap: 14px; flex: none; }\n.horaire .heure { width: 46px; flex: none; padding-top: 16px; font-size: 13px; font-weight: 700; color: var(--discret); }\n.horaire .cours { flex: 1; background: var(--surface); border-radius: 26px; padding: 14px 16px; display: flex; flex-direction: column; gap: 8px; }\n.horaire .cours.a-faire { background: var(--fond); box-shadow: inset 0 0 0 1.5px var(--lime); }\n.horaire .cours.libre { background: transparent; box-shadow: inset 0 0 0 1.5px var(--bord); color: var(--pale); }\n.horaire .attrib { display: flex; gap: 8px; flex-wrap: wrap; }\n\n/* ---- Succès, erreur ---- */\n.rond-grand { width: 96px; height: 96px; border-radius: 50%; display: grid; place-items: center; margin-bottom: 8px; }\n.rond-grand .ic { width: 44px; height: 44px; stroke-width: 2.2; }\n.rond-grand.ok { background: var(--lime); color: var(--encre); }\n.rond-grand.alerte { background: var(--corail-clair); color: var(--corail); }\n.rond-grand.lime { background: var(--lime-clair); color: var(--encre); }\n.gros-titre { font-size: 26px; font-weight: 700; letter-spacing: 0; line-height: 1.15; color: var(--encre); }\n.texte-doux { color: var(--discret); max-width: 300px; }\n.bas { display: flex; flex-direction: column; gap: 10px; padding: 0 20px 34px; flex: none; }\n\n/* ---- Feuille du bas ---- */\n.feuille-fond { position: absolute; inset: 0; background: hsl(100 100% 6% / 0.55); }\n.feuille { position: absolute; left: 0; right: 0; bottom: 0; background: var(--fond); border-radius: 34px 34px 0 0; padding: 12px 20px 34px; display: flex; flex-direction: column; gap: 14px; }\n.poignee { width: 40px; height: 5px; border-radius: 3px; background: var(--surface-2); align-self: center; }\n.feuille .gros-titre { font-size: 22px; }\n\n/* ---- Bouton flottant ---- */\n.fab { position: absolute; right: 20px; bottom: 112px; height: 54px; padding: 0 24px 0 18px; border-radius: 99px; background: var(--lime); color: var(--encre); font-weight: 700; font-size: 16px; display: flex; gap: 8px; align-items: center; box-shadow: 0 10px 24px hsl(100 80% 12% / 0.18); }\n\n/* ---- Notifications ---- */\n.notif { display: flex; gap: 14px; padding: 14px 4px; border-bottom: 1px solid var(--surface); flex: none; }\n.notif .texte { flex: 1; display: flex; flex-direction: column; gap: 2px; }\n.notif .quand { font-size: 12px; color: var(--discret); white-space: nowrap; }\n.notif .vignette { background: var(--surface); }\n.notif .vignette.lime { background: var(--lime); }\n.notif.neuve .titre::after { content: ''; display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--corail); margin-left: 8px; }\n\n/* ---- Ouverture, accueil, connexion ---- */\n.ouverture-coeur { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; padding-bottom: 60px; text-align: center; }\n.logo { position: relative; font-size: 64px; font-weight: 700; letter-spacing: -0.04em; line-height: 1; color: var(--encre); }\n.logo .trait { position: absolute; left: -2%; bottom: -16px; width: 104%; height: 18px; fill: none; stroke: var(--lime); stroke-width: 6; stroke-linecap: round; }\n.accroche { color: var(--discret); font-size: 17px; margin-top: 16px; max-width: 250px; }\n\n.accueil { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 0 24px 0; text-align: center; }\n.illu { width: 250px; height: 208px; flex: none; fill: none; stroke: #000; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }\n.accueil .gros-titre { margin-top: 30px; font-size: 28px; }\n.accueil p { margin-top: 8px; color: var(--encre); max-width: 300px; font-size: 15px; }\n.progres { display: flex; gap: 8px; width: 100%; margin-top: 28px; }\n.progres i { flex: 1; height: 3px; border-radius: 2px; background: var(--surface); }\n.progres i.fait { background: var(--lime); }\n.accueil-bas { display: flex; flex-direction: column; gap: 10px; padding: 24px 24px 40px; flex: none; }\n\n.connexion { flex: 1; display: flex; flex-direction: column; gap: 12px; padding: 78px 24px 0; }\n.connexion .titre-ecran { flex: none; text-align: center; font-size: 28px; margin-bottom: 16px; }\n",
 "jetons": [
  [
   "--encre",
   "Encre"
  ],
  [
   "--lime",
   "Citron"
  ],
  [
   "--lime-clair",
   "Citron clair"
  ],
  [
   "--surface",
   "Surface"
  ],
  [
   "--fond",
   "Fond"
  ],
  [
   "--toile",
   "Toile"
  ],
  [
   "--discret",
   "Discret"
  ],
  [
   "--corail",
   "Pris"
  ]
 ],
 "stylesTexte": [
  [
   ".logo",
   "Logo"
  ],
  [
   ".titre-ecran",
   "Titre d’écran"
  ],
  [
   ".gros-titre",
   "Grand titre"
  ],
  [
   ".titre",
